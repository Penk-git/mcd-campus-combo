{
  "envId": "cloud1-d3g3n612g3037e59b",
  "functionRoot": "functions",
  "functions": [
    {
      "name": "mcd-proxy",
      "timeout": 30,
      "memorySize": 256,
      "runtime": "Nodejs18.15",
      "installDependency": false,
      "handler": "index.main",
      "envVariables": {
        "MCD_MCP_TOKEN": ""
      },
      "triggers": [
        {
          "name": "http",
          "type": "http",
          "config": "{\"methods\":[\"GET\",\"POST\",\"OPTIONS\"]}"
        }
      ]
    }
  ]
}
