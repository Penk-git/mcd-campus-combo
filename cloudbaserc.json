{
  "envId": "{{CLOUDBASE_ENV_ID}}",
  "framework": {
    "name": "mcd-campus-combo",
    "plugins": {
      "static": {
        "use": "@cloudbase/framework-plugin-website",
        "inputs": {
          "outputPath": ".",
          "cloudPath": "/",
          "ignore": [
            "functions/**",
            "*.py",
            "node_modules/**",
            ".git/**"
          ]
        }
      },
      "mcd-proxy": {
        "use": "@cloudbase/framework-plugin-function",
        "inputs": {
          "name": "mcd-proxy",
          "path": "/mcd-proxy",
          "functionRoot": "functions/mcd-proxy",
          "runtime": "Nodejs18.15",
          "timeout": 30,
          "memorySize": 256,
          "envVariables": {
            "MCD_MCP_TOKEN": ""
          }
        }
      }
    }
  }
}
